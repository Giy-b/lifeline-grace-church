DATABASE_URL=postgresql://user:password@host:5432/database
# Optional comma-separated additions. The Vercel production URL and local Vite
# origins are always allowed by the backend.
FRONTEND_ORIGINS=https://your-custom-frontend-domain.example
DEFAULT_BISHOP_USERNAME=bishop
DEFAULT_BISHOP_PASSWORD=change-this-password
DEFAULT_BISHOP_FULL_NAME=Church Bishop
DEFAULT_BISHOP_PHONE=

# Cloudinary persistent storage for Home and Branch gallery uploads.
# Add real values only to Backend/.env locally and deployment environment variables.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
